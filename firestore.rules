/**
 * @fileOverview Firestore Security Rules for groupchat application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of ownership-based and role-based access control.
 * User documents are strictly owned by the authenticated user. Groups are managed by
 * admins and shared among members. Messages within groups inherit group membership for
 * authorization. The design denormalizes data to enable simple and performant security rules.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Only the user can read/write their own profile.
 * - /groups/{groupId}: Stores group information, including admin and members.
 * - /groups/{groupId}/messages/{messageId}: Stores messages within a group, inheriting group membership from the parent document.
 * - /roles_admin/{userId}: Document existence signifies admin role.
 *
 * Key Security Decisions:
 * - User listing is disabled.
 * - Admin role assignments are controlled via a separate collection.
 * - Default security posture is strict; any access not explicitly allowed is denied.
 *
 * Denormalization for Authorization:
 * - The `messages` subcollection denormalizes group membership data (`memberIds`) to enable
 *   message write authorization without additional `get()` calls.
 *
 * Structural Segregation:
 * - User profiles are stored in a dedicated collection (`/users/{userId}`) to clearly
 *   separate them from other data, simplifying access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - Authenticated user can create their own profile if the userId matches their auth.uid.
     * @allow (get, update, delete) - Authenticated user can read, update, or delete their own profile.
     * @deny (list) - User listing is not allowed.
     * @deny (create) - Authenticated user cannot create profile if userId does not match their auth.uid.
     * @deny (update, delete) - An unauthenticated user cannot update or delete any profile.
     * @principle Enforces document ownership for user profiles, validating the UID on create and enforcing immutability of the UID on update.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; // Enforce immutability of userId
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to group documents.
     * @path /groups/{groupId}
     * @allow (create) - Any authenticated user can create a group.
     * @allow (get, list) - Any user can read any group.
     * @allow (update, delete) - Only the group admin (adminId) can update or delete the group.
     * @deny (update, delete) - Non-admin users cannot update or delete groups.
     * @principle Manages group creation, open access for reads, and restricts modification to the admin.
     */
    match /groups/{groupId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin(adminId) {
        return request.auth.uid == adminId;
      }

      function isExistingAdmin(adminId) {
        return isAdmin(adminId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isExistingAdmin(resource.data.adminId);
      allow delete: if isExistingAdmin(resource.data.adminId);
    }

    /**
     * @description Controls access to messages within a group.
     * @path /groups/{groupId}/messages/{messageId}
     * @allow (create) - Any authenticated user can create a message in a group. The request must include the senderId field, matching the user id.
     * @allow (get, list) - Any user can read any message in a group.
     * @allow (update, delete) - No one can update or delete a message.
     * @deny (update, delete) - Updating or deleting a message is always denied.
     * @principle Manages message creation within groups, enforcing that sender ID matches the authenticated user, and restricting modification.
     */
    match /groups/{groupId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.groupId == groupId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to admin role documents.
     * @path /roles_admin/{userId}
     * @allow (create) - No direct creation allowed through client.
     * @allow (get) - Any authenticated user can check the existance of the document to see if user is admin.
     * @allow (list) - Listing not allowed.
     * @allow (update) - No updates.
     * @allow (delete) - No direct deletion allowed.
     * @principle Document existance indicates admin role.
     */
    match /roles_admin/{userId} {
        function isSignedIn() {
            return request.auth != null;
        }
        allow get: if isSignedIn();
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}
